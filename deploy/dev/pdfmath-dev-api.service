[Unit]
Description=PDFMath development translation API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/pdf/PDFMathTranslate-next
Environment=PATH=/root/miniconda3/envs/babledoc/bin:/usr/local/bin:/usr/bin:/bin
Environment=PDF2ZH_API_HOST=127.0.0.1
Environment=PDF2ZH_API_PORT=11009
Environment=PDF2ZH_WORK_DIR=/var/lib/pdfmath-dev/work
Environment=PDF2ZH_MAX_CONCURRENT=1
Environment=PDF2ZH_QPS=1
Environment=PDF2ZH_POOL_MAX_WORKERS=1
Environment=PDF2ZH_NO_MONO=true
Environment=PDF2ZH_MAX_PAGES_PER_PART=50
ExecStart=/root/miniconda3/envs/babledoc/bin/python -m pdf2zh_next.main --api
Restart=on-failure
RestartSec=5
StateDirectory=pdfmath-dev
StateDirectoryMode=0700
CPUQuota=80%
MemoryMax=1400M
# The 2GB development host has 4GB swap. PDF workers can exceed resident RAM
# even for one page, so allow paging while retaining the physical-memory cap.
MemorySwapMax=2G
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
