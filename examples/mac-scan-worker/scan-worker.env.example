# Copy to ~/.config/pdfmath-scan-worker.env (chmod 600) and fill in.
GATEWAY_URL=https://2026669.me
# Same value as SCAN_WORKER_TOKEN in the gateway's .env
SCAN_WORKER_TOKEN=
# Local OpenAI-compatible proxy; the model must accept image input.
OPENAI_BASE_URL=http://127.0.0.1:3425/v1
OPENAI_API_KEY=
# Comma-separated: later models are used when an earlier one runs out of quota.
VISION_MODEL=codex/gpt-5.6-luna
# ocrmypdf with the appleocr plugin (Tesseract is used as a backup for skipped lines)
OCRMYPDF=~/pdf-tools/ocr-venv/bin/ocrmypdf
# Optional
# WORK_DIR=~/Library/Application Support/pdfmath-scan-worker
# LONG_POLL_SECONDS=300        # each wait for an order is held this long by the gateway
# NIGHT_HOURS=1-7              # sleep NIGHT_IDLE_SECONDS between polls in these hours
# NIGHT_IDLE_SECONDS=1500
# HOLD_PROBLEM_PAGES=5         # large orders with this many failing pages are held for review
# TRANSLATE_WORKERS=8
# GLOSSARY_FILE=~/pdf-tools/glossary.csv
