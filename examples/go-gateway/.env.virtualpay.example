# Copy into your ignored .env. Never commit real secrets.
# Enable only after MP products, HTTPS callback and deployment checks are ready.
VIRTUALPAY_ENABLED=false
# Optional: allow one free three-page standard trial without enabling payment.
TRIAL_ENABLED=false
VIRTUALPAY_OFFER_ID=
VIRTUALPAY_APP_KEY=
VIRTUALPAY_NOTIFY_TOKEN=
VIRTUALPAY_ENCODING_AES_KEY=
# Persistent disk, one gateway process only; production should use absolute path.
VIRTUALPAY_DATA_DIR=./data/virtualpay
# Published product IDs; one unit is one PDF page. Prices must match MP.
VIRTUALPAY_STANDARD_PRODUCT_ID=
VIRTUALPAY_STANDARD_PRICE_FEN=10
VIRTUALPAY_ENHANCED_PRODUCT_ID=
VIRTUALPAY_ENHANCED_PRICE_FEN=30
# Optional per-engine products; set both or neither (unset: standard/enhanced product).
# VIRTUALPAY_GOOGLE_PRODUCT_ID=
# VIRTUALPAY_GOOGLE_PRICE_FEN=20
# VIRTUALPAY_GPT_PRODUCT_ID=
# VIRTUALPAY_GPT_PRICE_FEN=40
# Optional iOS unit product (e.g. a 0.5 yuan product). Apple payment rejects orders under 1 yuan
# (IOS_ORDER_PRICE_TOO_LOW), so iOS orders are rounded up to whole units, at least 1 yuan.
# Set both or neither; the unit price in fen must be at most 100.
# VIRTUALPAY_IOS_PRODUCT_ID=
# VIRTUALPAY_IOS_PRICE_FEN=50

# Cloudflare R2 result storage (optional; downloads are proxied through the gateway)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_JURISDICTION=
