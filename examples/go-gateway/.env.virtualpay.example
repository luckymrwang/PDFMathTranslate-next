# Copy into your ignored .env. Never commit real secrets.
# Enable only after MP products, HTTPS callback and deployment checks are ready.
VIRTUALPAY_ENABLED=false
VIRTUALPAY_OFFER_ID=
VIRTUALPAY_APP_KEY=
VIRTUALPAY_NOTIFY_TOKEN=
VIRTUALPAY_ENCODING_AES_KEY=
# Persistent disk, one gateway process only; production should use absolute path.
VIRTUALPAY_DATA_DIR=./data/virtualpay
# Published product IDs; one unit is one PDF page. Prices must match MP.
VIRTUALPAY_STANDARD_PRODUCT_ID=
VIRTUALPAY_STANDARD_PRICE_FEN=10
VIRTUALPAY_ENHANCED_PRODUCT_ID=
VIRTUALPAY_ENHANCED_PRICE_FEN=50
